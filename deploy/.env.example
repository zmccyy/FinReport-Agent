# FinReport Agent — 环境变量模板
# 复制为 .env 并根据需要修改
# 版本：v1.1（M4.09：LLM API 配置）

# === MySQL ===
MYSQL_ROOT_PASSWORD=finreport
MYSQL_DATABASE=finreport
MYSQL_USER=finreport
MYSQL_PASSWORD=finreport
MYSQL_PORT=3306

# === Redis ===
REDIS_PORT=6379
# REDIS_PASSWORD=     # 开发环境留空

# === RabbitMQ ===
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# === MinIO ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# === Milvus ===
MILVUS_PORT=19530
MILVUS_METRIC_PORT=9091

# === LLM API（2026-08-16 决策：推理走 DeepSeek 官方 API）===
# Key 不入库不入 git，仅通过本文件注入 ai-service（compose LLM_API_KEY）
LLM_API_KEY=
LLM_API_BASE_URL=https://api.deepseek.com
LLM_API_MODEL=deepseek-v4-flash

# === Application ===
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
FRONTEND_PORT=80
# JWT 签名密钥（>=32 字符）。缺省时 base compose 回退到 dev 密钥
# （M4.10 起注入，此前 base compose 缺 JWT_SECRET 会 WeakKeyException
# 重启循环）；生产环境必须替换为受管密钥。
# JWT_SECRET=change-me-in-production-to-a-long-random-secret

# === Model Weights ===
# bge-small-zh-v1.5 经 models 卷挂载到容器 /models（compose 已配置
# MODEL_EMBED_PATH=/models/bge-small-zh-v1.5）；下载方式：
#   python scripts/download_models.py          # 下载后 docker cp 进卷
#   docker cp ./models/. finreport-models:/models/

# === 构建镜像加速（可选；官方源被墙/限速的网络按需打开）===
# ai-service Dockerfile 构建期参数（M4.10），默认官方源：
# APT_MIRROR=mirrors.aliyun.com
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# 平铺式 torch CPU 镜像需固定 +cpu 版本，避免解析到 CUDA 变体。
# 注意：torch 须 >= 2.5（transformers 5.x 硬检查 torch>=2.5，更低版本会禁用
# PyTorch 后端导致 bge embedding 加载失败）；镜像体积由 Dockerfile 内
# __pycache__ 剥离控制，勿靠 torch 降级瘦身：
# TORCH_SPEC=torch==2.9.1+cpu
# TORCH_INSTALL_ARGS=--find-links https://mirrors.aliyun.com/pytorch-wheels/cpu/
